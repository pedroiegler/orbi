# ---------------------------------------------------------------------------
# ORBI — exemplo de configuracao. Copie para .env e preencha.
# Nenhum valor real deve ser commitado.
# ---------------------------------------------------------------------------

# Aplicacao
ORBI_ENV=development                  # development | staging | production
ORBI_LOG_LEVEL=INFO
ORBI_TIMEZONE=America/Sao_Paulo

# Chave de cifragem das credenciais de ERP (Fernet, 32 bytes url-safe base64).
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ORBI_SECRET_KEY=

# Banco
ORBI_DATABASE_URL=postgresql+psycopg://orbi_app:change-me@localhost:5433/orbi
ORBI_DATABASE_ADMIN_URL=postgresql+psycopg://postgres:change-me@localhost:5433/orbi

# LLM (dois fabricantes diferentes; rule_based e apenas para dev/CI).
# O primario hoje e o Gemini: a camada gratuita do Google AI Studio cobre a PoC.
# Pegue a chave em https://aistudio.google.com/apikey
ORBI_LLM_PRIMARY=gemini               # gemini | anthropic | openai | rule_based
ORBI_LLM_FALLBACK=                    # vazio ate haver o segundo fabricante
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_THINKING_BUDGET=0              # 0 desliga o raciocinio; -1 nao envia o campo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Embeddings (768 dimensoes)
ORBI_EMBEDDING_PROVIDER=hashing       # hashing | openai
ORBI_EMBEDDING_MODEL=text-embedding-3-small

# WhatsApp Cloud API (um numero por tenant; token por tenant fica em erp/channel config)
ORBI_WHATSAPP_API_VERSION=v21.0
ORBI_WHATSAPP_VERIFY_TOKEN=
ORBI_WHATSAPP_APP_SECRET=

# Canal de operacao (alertas + resumo diario)
ORBI_OPS_PHONE=
ORBI_OPS_PHONE_NUMBER_ID=
ORBI_OPS_ACCESS_TOKEN=

# Observabilidade (opcional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
