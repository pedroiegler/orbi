# ---------------------------------------------------------------------------
# ORBI — exemplo de configuracao. Copie para .env e preencha.
# Nenhum valor real deve ser commitado. O `.env` esta no `.gitignore`.
#
# Cada variavel esta explicada em docs/ORBI-CONFIGURACAO.md.
# Rode `orbi doctor` depois de mexer aqui.
# ---------------------------------------------------------------------------

# === Aplicacao =============================================================
ORBI_ENV=development                  # development | test | staging | production
ORBI_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
ORBI_TIMEZONE=America/Sao_Paulo       # fuso usado nas datas das respostas
ORBI_LOCALE=pt_BR                     # idioma dos templates de resposta

# Chave que cifra as credenciais de ERP e os tokens de canal (Fernet, 32 bytes
# url-safe base64). SEM ELA nenhuma credencial pode ser lida nem gravada.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Trocar esta chave torna ilegivel tudo que ja foi cifrado com a anterior.
ORBI_SECRET_KEY=

# === Banco =================================================================
# A aplicacao usa `orbi_app`, um papel SEM BYPASSRLS: ele nao pode ignorar o
# isolamento entre clientes nem alterar a auditoria.
ORBI_DATABASE_URL=postgresql+psycopg://orbi_app:change-me@localhost:5433/orbi
# O papel administrativo roda migration e comandos de operacao. Nunca o Runtime.
ORBI_DATABASE_ADMIN_URL=postgresql+psycopg://postgres:change-me@localhost:5433/orbi
ORBI_DATABASE_POOL_SIZE=5             # conexoes simultaneas; subir so com gargalo medido
ORBI_DATABASE_ECHO=false              # true imprime todo SQL — use so para depurar

# === Orcamento de tempo do turno ===========================================
# Meta do produto: 2 a 4 segundos. Estes numeros sao o teto, nao o alvo.
ORBI_DEADLINE_TOTAL_MS=10000          # orcamento do turno inteiro
ORBI_LLM_TIMEOUT_MS=4000              # quanto o Orbi espera pelo modelo
ORBI_ERP_TIMEOUT_MS=6000              # quanto o Orbi espera pelo ERP do cliente
ORBI_SLOW_REPLY_THRESHOLD_MS=2500     # acima disso manda "consultando..."

# === LLM ===================================================================
# O primario hoje e o Gemini: a camada gratuita do Google AI Studio cobre a PoC.
# Chave em https://aistudio.google.com/apikey
# O fallback precisa ser de OUTRO fabricante — dois provedores da mesma empresa
# caem juntos, e o failover vira enfeite.
ORBI_LLM_PRIMARY=gemini               # gemini | anthropic | openai | rule_based
ORBI_LLM_FALLBACK=                    # vazio ate haver o segundo fabricante

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite    # veja a cota por modelo em ORBI-CONFIGURACAO.md
GEMINI_THINKING_BUDGET=-1             # 0 desliga o raciocinio; -1 nao envia o campo (modelos `lite`)

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# A resposta e montada por template, nunca redigida pelo LLM. Manter falso.
ORBI_LLM_RENDERING_ENABLED=false

# === Embeddings ============================================================
# `hashing` roda local, sem chave e sem custo. `openai` entende sinonimo.
ORBI_EMBEDDING_PROVIDER=hashing       # hashing | openai
ORBI_EMBEDDING_MODEL=text-embedding-3-small

# === Canal WhatsApp ========================================================
# O numero e do cliente, nao do Orbi. O token de cada cliente fica cifrado no
# banco (`orbi tenant set-token`); o que fica aqui vale para o app inteiro.
ORBI_WHATSAPP_API_VERSION=v21.0
ORBI_WHATSAPP_VERIFY_TOKEN=           # voce inventa; a Meta repete no handshake
ORBI_WHATSAPP_APP_SECRET=             # Meta > App > Config. Basica. Sem ele, producao recusa webhook

# === Canal de operacao =====================================================
# Numero interno da equipe: alertas imediatos e resumo diario.
ORBI_OPS_PHONE=
ORBI_OPS_PHONE_NUMBER_ID=
ORBI_OPS_ACCESS_TOKEN=

# === Observabilidade (opcional) ============================================
# Sem chave, o trace vive so em `audit_logs` e o Orbi funciona igual.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
