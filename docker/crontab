# ORBI — rotinas de operacao (ORBI.md secoes 7 e 14).
# Horarios em UTC; o servidor roda em Sao Paulo (UTC-3).
SHELL=/bin/sh
PATH=/opt/venv/bin:/usr/local/bin:/usr/bin:/bin

# `orbi tenant list --slugs --ativos` devolve um slug por linha, sem
# formatacao. Extrair slug da tabela desenhada com `awk` nao funcionava: a
# borda virava item vazio e nome que quebra em duas linhas virava um item `|`,
# entao cada cliente acrescentava uma falha por noite no log.
# Cliente inativo fica de fora de proposito — sincronizar catalogo de quem
# cancelou gasta chamada de ERP e embedding sem servir a ninguem.

# Sync completo do catalogo, de madrugada (03:00 em Sao Paulo).
0 6 * * * orbi tenant list --slugs --ativos | while read -r t; do orbi catalog sync --tenant "$t"; done >> /var/log/orbi-sync.log 2>&1

# Incremental a cada 4 horas.
0 */4 * * * orbi tenant list --slugs --ativos | while read -r t; do orbi catalog sync --tenant "$t" --mode incremental; done >> /var/log/orbi-sync.log 2>&1

# Resumo diario no canal de ops, as 7h de Sao Paulo.
0 10 * * * orbi maintenance daily-summary --send >> /var/log/orbi-ops.log 2>&1

# Particoes do proximo mes, todo dia 25.
0 5 25 * * orbi maintenance partitions >> /var/log/orbi-ops.log 2>&1

# Expurgo por retencao, aos domingos.
30 5 * * 0 orbi maintenance purge --apply >> /var/log/orbi-ops.log 2>&1

# Shadow evals: 5% das perguntas do dia contra o prompt atual, de madrugada.
30 4 * * * orbi maintenance shadow-evals >> /var/log/orbi-ops.log 2>&1

# Integridade da corrente de auditoria, toda segunda.
0 7 * * 1 orbi maintenance verify-audit >> /var/log/orbi-ops.log 2>&1
